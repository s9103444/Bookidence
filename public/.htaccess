# 把找不到的路徑交給 index.html，Vue Router 才能處理 /admin、/books/3 這種網址。
# 放在 public/，build 時會自動複製到 dist/ 根目錄，不用手動搬。

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ckd101/g1/front/

  # 真的存在的檔案和資料夾照原樣給（JS、CSS、圖片）
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 其餘一律回 index.html
  RewriteRule . /ckd101/g1/front/index.html [L]
</IfModule>
